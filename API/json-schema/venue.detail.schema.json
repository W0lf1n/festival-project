{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Venue Detail Schema",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "type": { "type": "string" },
    "capacity": { "type": "integer" },
    "description": { "type": "string" },
    "address": {
      "type": "object",
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" }
      },
      "required": ["street", "city"]
    }
  },
  "required": ["id", "name", "type", "capacity", "address"]
}