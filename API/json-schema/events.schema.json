{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Events List Schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "title": { "type": "string" },
      "category": { "type": "string" },
      "venueId": { "type": "string" },
      "start": { "type": "string", "format": "date-time" },
      "end": { "type": "string", "format": "date-time" }
    },
    "required": ["id", "title", "category", "venueId", "start", "end"]
  }
}