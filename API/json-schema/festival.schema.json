{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Festival Info Schema",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "edition": { "type": "string" },
    "city": { "type": "string" },
    "startDate": { "type": "string", "format": "date" },
    "endDate": { "type": "string", "format": "date" }
  },
  "required": ["id", "name", "edition", "city", "startDate", "endDate"]
}